{
  "name": "yatb",
  "private": true,
  "packageManager": "npm@11.6.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @yatb/web",
    "dev:studio": "npm run dev --workspace @yatb/studio",
    "check:ui": "node scripts/check-shared-ui.mjs",
    "check": "npm run check:ui && npm run check --workspaces --if-present",
    "build": "npm run build --workspaces --if-present && node scripts/check-emitted-ui.mjs",
    "preview": "npm run preview --workspace @yatb/web",
    "preview:studio": "npm run preview --workspace @yatb/studio",
    "deploy:web": "npm run deploy --workspace @yatb/web",
    "deploy:studio": "npm run deploy:studio:production",
    "deploy:studio:production": "npm run production:deploy --workspace @yatb/studio",
    "validate:studio:production": "npm run production:validate --workspace @yatb/studio",
    "migrate:studio:production": "npm run production:migrate --workspace @yatb/studio"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.63.2",
    "@rollup/rollup-linux-x64-gnu": "4.63.2"
  }
}
