{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yatb-studio",
  "account_id": "32967fffa44c1d38bc86ab6e4e419edb",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "studio.youraveragetechbro.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  "vars": {
    "APP_ORIGIN": "https://studio.youraveragetechbro.com",
    "EMAIL_MODE": "cloudflare",
    "EMAIL_FROM": "studio@studio-mail.youraveragetechbro.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yatb-studio",
      "database_id": "e2d62270-da2c-4def-b3ce-878f1e02af9d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "yatb-studio-media"
    }
  ],
  "send_email": [
    {
      "name": "AUTH_EMAIL",
      "allowed_destination_addresses": [
        "dohyun@youraveragetechbro.com",
        "jivedwinedompales@gmail.com"
      ],
      "allowed_sender_addresses": [
        "studio@studio-mail.youraveragetechbro.com"
      ]
    }
  ]
}
