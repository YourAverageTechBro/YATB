{
  "name": "@yatb/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "cf-typecheck": "wrangler types --env-interface CloudflareEnv --check",
    "typecheck": "tsc --noEmit",
    "check": "npm run cf-typecheck && npm run typecheck",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "deploy": "npm run check && npm run build && CLOUDFLARE_ACCOUNT_ID=32967fffa44c1d38bc86ab6e4e419edb wrangler deploy"
  },
  "dependencies": {
    "@yatb/ui": "*",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-start": "1.168.52",
    "lucide-react": "^0.479.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "17.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@tailwindcss/vite": "^4.0.14",
    "@tanstack/router-cli": "1.167.35",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "^4.0.14",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "wrangler": "4.131.1"
  }
}
